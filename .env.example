# Optional defaults. The app also accepts an OpenAI key in its login/API-key screen.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=6
SCORE_THRESHOLD=0.08
VECTOR_STORE_PATH=data/vector_store
LOG_LEVEL=INFO
ADMIN_EMAIL=admin@pearlzhome.example
ADMIN_PASSWORD=
